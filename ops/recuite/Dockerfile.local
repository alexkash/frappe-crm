# Build reviewed local source without publishing it or changing the current base tag.
ARG CRM_BASE=recuite/crm:v1.88.0-20261017
FROM ${CRM_BASE}
ARG CRM_REVISION
LABEL org.opencontainers.image.revision=${CRM_REVISION}
USER frappe
WORKDIR /home/frappe/frappe-bench
ENV PYTHONDONTWRITEBYTECODE=1
COPY --chown=frappe:frappe crm apps/crm/crm
RUN rm -rf apps/crm/crm/public/frontend
COPY --chown=frappe:frappe ops/recuite/billing-test/.frontend-build apps/crm/crm/public/frontend
COPY --chown=frappe:frappe extensions/recuite_billing apps/recuite_billing
RUN env/bin/pip install --no-deps -e apps/recuite_billing \
    && ln -s /home/frappe/frappe-bench/apps/recuite_billing/recuite_billing/public /home/frappe/frappe-bench/assets/recuite_billing \
    && ls -1 apps > sites/apps.txt \
    && env/bin/python -c 'import frappe,crm,recuite_billing; assert frappe.__version__ == "15.123.1"; assert crm.__version__ == "1.88.0"; assert recuite_billing.__version__ == "0.1.0"' \
    && test -s apps/crm/crm/public/frontend/index.html \
    && test -s apps/crm/crm/www/crm.html
